<Window x:Class="WinWidgetTimer.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinWidgetTimer — Settings"
        Width="820" Height="860"
        MinWidth="760" MinHeight="790"
        WindowStartupLocation="CenterScreen"
        Background="#FF181825"
        Foreground="#FFCDD6F4"
        WindowStyle="SingleBorderWindow"
        Loaded="Window_Loaded"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Main content ── -->
        <Grid Grid.Row="0" Margin="16,16,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>      <!-- upper two-column -->
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>   <!-- Widget Appearance -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════
                 LEFT — Widget name + Timers list + Add/Del
                 ═══════════════════════════════════════════ -->
            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- widget name row -->
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>  <!-- list header -->
                    <RowDefinition Height="*"/>     <!-- timer list -->
                    <RowDefinition Height="Auto"/>  <!-- add / delete -->
                </Grid.RowDefinitions>

                <!-- Widget Name -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Widget Name:"
                               Foreground="#FFA6ADC8" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="2"
                             Style="{StaticResource DarkTextBox}"
                             Text="{Binding WidgetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <!-- List header -->
                <Grid Grid.Row="2" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="9"/>
                        <ColumnDefinition Width="75"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Timers"
                               FontSize="13" FontWeight="SemiBold" Foreground="#FF89B4FA"/>
                    <Rectangle Grid.Column="1" Width="1" Fill="#FF454570"
                               HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                    <TextBlock Grid.Column="2" Text="Format"
                               FontSize="11" FontWeight="SemiBold" Foreground="#FF89B4FA"
                               VerticalAlignment="Bottom" Margin="4,0,0,0"/>
                </Grid>

                <!-- Timer list -->
                <ListBox Grid.Row="3"
                         x:Name="TimersList"
                         ItemsSource="{Binding Timers}"
                         SelectedItem="{Binding SelectedTimer, Mode=TwoWay}"
                         Background="#FF1E1E2E"
                         BorderBrush="#FF454570"
                         Foreground="#FFCDD6F4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="TimersList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="TimersList_PreviewMouseMove"
                         PreviewMouseLeftButtonUp="TimersList_PreviewMouseLeftButtonUp"
                         DragOver="TimersList_DragOver"
                         Drop="TimersList_Drop">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,7"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#FFCDD6F4"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FF313244"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF2A2A3E"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="9"/>
                                    <ColumnDefinition Width="75"/>
                                </Grid.ColumnDefinitions>
                                <!-- Drag handle -->
                                <Border Grid.Column="0" Tag="DragHandle"
                                        Padding="3,0"
                                        Cursor="SizeAll" VerticalAlignment="Center"
                                        Background="Transparent" ToolTip="Drag to reorder">
                                    <UniformGrid Columns="2" Rows="3" Width="8" Height="12">
                                        <Ellipse Fill="#FF585B70" Margin="0.5"/>
                                        <Ellipse Fill="#FF585B70" Margin="0.5"/>
                                        <Ellipse Fill="#FF585B70" Margin="0.5"/>
                                        <Ellipse Fill="#FF585B70" Margin="0.5"/>
                                        <Ellipse Fill="#FF585B70" Margin="0.5"/>
                                        <Ellipse Fill="#FF585B70" Margin="0.5"/>
                                    </UniformGrid>
                                </Border>
                                <!-- Color dot -->
                                <Ellipse Grid.Column="2" Width="10" Height="10"
                                         VerticalAlignment="Center"
                                         Fill="{Binding ColorBrush}"/>
                                <!-- Type icon -->
                                <TextBlock Grid.Column="4"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Text="{Binding TypeIcon}"/>
                                <!-- Name -->
                                <TextBlock Grid.Column="6"
                                           Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- Duration preview -->
                                <TextBlock Grid.Column="8"
                                           Text="{Binding DurationPreview}"
                                           VerticalAlignment="Center"
                                           Foreground="#FF6C7086"
                                           FontFamily="Consolas, Courier New"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- Format column -->
                                <Rectangle Grid.Column="9" Width="1" Fill="#FF454570"
                                           HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                           Margin="0,1,0,1"/>
                                <TextBlock Grid.Column="10"
                                           Text="{Binding Format}"
                                           VerticalAlignment="Center"
                                           Foreground="#FFCDD6F4"
                                           FontFamily="Consolas, Courier New"
                                           FontSize="11"
                                           Margin="4,0,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Add / Delete buttons -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="+ Add"    Style="{StaticResource SubtleButton}"
                            Padding="10,5" Margin="0,0,6,0" Click="Add_Click"/>
                    <Button Content="− Delete" Style="{StaticResource SubtleButton}"
                            Padding="10,5"
                            IsEnabled="{Binding HasSelectedTimer}"
                            Click="Delete_Click"/>
                </StackPanel>
            </Grid>

            <!-- ════════════════════════════════════════════════
                 RIGHT — Timer properties (enabled when selected)
                 ════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Grid.Column="2"
                    Background="#FF1E1E2E"
                    CornerRadius="6"
                    Padding="16">
                <Grid IsEnabled="{Binding HasSelectedTimer}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- 0  name -->
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>  <!-- 2  type -->
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>  <!-- 4  color -->
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>  <!-- 6  separator -->
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>  <!-- 8  countdown duration -->
                        <RowDefinition Height="Auto"/>  <!-- 9  alarm time -->
                        <RowDefinition Height="10"/>    <!-- 10 spacer -->
                        <RowDefinition Height="Auto"/>  <!-- 11 time format -->
                        <RowDefinition Height="10"/>    <!-- 12 spacer -->
                        <RowDefinition Height="Auto"/>  <!-- 13 on completion -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Timer Name -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Timer Name" Style="{StaticResource DarkLabel}"/>
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding SelectedTimerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Timer Type -->
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Timer Type" Style="{StaticResource DarkLabel}"/>
                        <ComboBox x:Name="TimerTypeCombo"
                                  Style="{StaticResource DarkComboBox}"
                                  SelectionChanged="TimerTypeCombo_SelectionChanged">
                            <ComboBoxItem Content="⏱  Countdown  — counts down from a duration"/>
                            <ComboBoxItem Content="⏹  Elapsed    — stopwatch, counts up"/>
                            <ComboBoxItem Content="🔔  Alarm      — triggers at a specific time"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Row Color -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Row Color:"
                                   Foreground="#FFA6ADC8"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border x:Name="TimerColorSwatch"
                                Width="50" Height="22" CornerRadius="4"
                                Margin="0,0,8,0"
                                Background="{Binding SelectedTimerColorBrush}"
                                Cursor="Hand"
                                MouseLeftButtonDown="ColorSwatch_Click"
                                ToolTip="Click to change color"/>
                        <Button Content="Change…"
                                Style="{StaticResource SubtleButton}"
                                Padding="10,4"
                                Click="ColorSwatch_Click"/>
                        <TextBlock x:Name="TimerColorHexLabel"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="#FF6C7086" FontSize="11"
                                   FontFamily="Consolas, Courier New"/>
                    </StackPanel>

                    <!-- Separator between common and type-specific -->
                    <Rectangle Grid.Row="6" Height="1" Fill="#FF313244"/>

                    <!-- ─── Countdown duration ─────────────────── -->
                    <StackPanel Grid.Row="8"
                                x:Name="CountdownSection"
                                Visibility="Collapsed">
                        <TextBlock Text="Duration  (HH : MM : SS)" Style="{StaticResource DarkLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="DurHours"
                                     Style="{StaticResource DarkTextBox}"
                                     Width="52" MaxLength="3"
                                     TextAlignment="Center"
                                     ToolTip="Hours"
                                     TextChanged="Duration_TextChanged"/>
                            <TextBlock Text=" : " Foreground="#FF6C7086"
                                       VerticalAlignment="Center" FontSize="16" Margin="4,0"/>
                            <TextBox x:Name="DurMinutes"
                                     Style="{StaticResource DarkTextBox}"
                                     Width="52" MaxLength="2"
                                     TextAlignment="Center"
                                     ToolTip="Minutes (0-59)"
                                     TextChanged="Duration_TextChanged"/>
                            <TextBlock Text=" : " Foreground="#FF6C7086"
                                       VerticalAlignment="Center" FontSize="16" Margin="4,0"/>
                            <TextBox x:Name="DurSeconds"
                                     Style="{StaticResource DarkTextBox}"
                                     Width="52" MaxLength="2"
                                     TextAlignment="Center"
                                     ToolTip="Seconds (0-59)"
                                     TextChanged="Duration_TextChanged"/>
                        </StackPanel>
                        <TextBlock x:Name="DurationPreviewLabel"
                                   Margin="0,6,0,0" FontSize="11"
                                   Foreground="#FF89B4FA"/>
                    </StackPanel>

                    <!-- ─── Alarm time ──────────────────────────── -->
                    <StackPanel Grid.Row="9"
                                x:Name="AlarmSection"
                                Visibility="Collapsed">
                        <TextBlock Text="Alarm Schedule" Style="{StaticResource DarkLabel}"/>
                        <!-- Day of week row -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Day:"
                                       Foreground="#FFA6ADC8"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="AlarmDayCombo"
                                      Style="{StaticResource DarkComboBox}"
                                      Width="122"
                                      SelectionChanged="AlarmDay_SelectionChanged">
                                <ComboBoxItem Content="Daily"/>
                                <ComboBoxItem Content="Sunday"/>
                                <ComboBoxItem Content="Monday"/>
                                <ComboBoxItem Content="Tuesday"/>
                                <ComboBoxItem Content="Wednesday"/>
                                <ComboBoxItem Content="Thursday"/>
                                <ComboBoxItem Content="Friday"/>
                                <ComboBoxItem Content="Saturday"/>
                            </ComboBox>
                        </StackPanel>
                        <!-- Time row -->
                        <TextBlock Text="Time  (HH : MM)" Style="{StaticResource DarkLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="AlarmHour"
                                     Style="{StaticResource DarkTextBox}"
                                     Width="52" MaxLength="2"
                                     TextAlignment="Center"
                                     ToolTip="Hour (0-23)"
                                     TextChanged="AlarmTime_TextChanged"/>
                            <TextBlock Text=" : " Foreground="#FF6C7086"
                                       VerticalAlignment="Center" FontSize="16" Margin="4,0"/>
                            <TextBox x:Name="AlarmMinute"
                                     Style="{StaticResource DarkTextBox}"
                                     Width="52" MaxLength="2"
                                     TextAlignment="Center"
                                     ToolTip="Minute (0-59)"
                                     TextChanged="AlarmTime_TextChanged"/>
                            <TextBlock x:Name="AlarmPreviewLabel"
                                       Margin="14,0,0,0" VerticalAlignment="Center"
                                       Foreground="#FF89B4FA" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ─── Time Format ──────────────────────────────── -->
                    <StackPanel Grid.Row="11"
                                x:Name="FormatSection">
                        <TextBlock Text="Time Format" Style="{StaticResource DarkLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     x:Name="FormatBox"
                                     Style="{StaticResource DarkTextBox}"
                                     FontFamily="Consolas, Courier New"
                                     TextChanged="TimerFormat_TextChanged"
                                     ToolTip="Display format — e.g. HH:mm:ss or ddd HH:mm for alarm"/>
                            <Button Grid.Column="2"
                                    x:Name="FormatHelpBtn"
                                    Content="?"
                                    Style="{StaticResource SubtleButton}"
                                    Padding="9,5" FontWeight="Bold"
                                    ToolTip="Show format token reference"
                                    Click="FormatHelp_Click"/>
                        </Grid>
                        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="#FF6C7086"
                                   Text="(e.g. HH:mm:ss  or  ddd HH:mm for alarm)"/>
                    </StackPanel>

                    <!-- ─── On Completion (Countdown + Alarm only) ─── -->
                    <StackPanel Grid.Row="13"
                                x:Name="CompletionSection"
                                Visibility="Collapsed">
                        <Rectangle Height="1" Fill="#FF313244" Margin="0,0,0,10"/>
                        <TextBlock Text="On Completion" Style="{StaticResource DarkLabel}"/>
                        <CheckBox x:Name="FlashCheck"
                                  Content="Flash widget"
                                  Foreground="#FFCDD6F4"
                                  Margin="0,0,0,8"
                                  Checked="FlashCheck_Changed"
                                  Unchecked="FlashCheck_Changed"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Sound:" Foreground="#FFA6ADC8"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="SoundCombo"
                                      Style="{StaticResource DarkComboBox}"
                                      Width="170"
                                      SelectionChanged="SoundCombo_SelectionChanged"/>
                            <Button Content="▶ Test"
                                    Style="{StaticResource SubtleButton}"
                                    Padding="8,4" Margin="8,0,0,0"
                                    Click="TestSound_Click"/>
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════
                 WIDGET APPEARANCE — full-width bottom section
                 ══════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                    Background="#FF1E1E2E"
                    CornerRadius="6"
                    Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- 0: section title -->
                        <RowDefinition Height="10"/>     <!-- 1: spacer -->
                        <RowDefinition Height="Auto"/>   <!-- 2: controls row -->
                        <RowDefinition Height="10"/>     <!-- 3: spacer -->
                        <RowDefinition Height="Auto"/>   <!-- 4: checkboxes -->
                        <RowDefinition Height="8"/>      <!-- 5: spacer -->
                        <RowDefinition Height="Auto"/>   <!-- 6: position header -->
                        <RowDefinition Height="8"/>      <!-- 7: spacer -->
                        <RowDefinition Height="Auto"/>   <!-- 8: screen-map canvas -->
                        <RowDefinition Height="4"/>      <!-- 9: spacer -->
                        <RowDefinition Height="Auto"/>   <!-- 10: hint text -->
                    </Grid.RowDefinitions>

                    <!-- Section title -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Widget Appearance"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#FF89B4FA"
                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Rectangle Grid.Column="1" Height="1" Fill="#FF454570" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Controls row -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                        <!-- Background color -->
                        <TextBlock Text="Background:" Foreground="#FFA6ADC8"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border x:Name="BgColorSwatch"
                                Width="40" Height="22" CornerRadius="3"
                                Background="{Binding BgColorBrush}"
                                BorderBrush="#FF454570" BorderThickness="1"
                                Cursor="Hand" Margin="0,0,8,0"
                                MouseLeftButtonDown="BgColorSwatch_Click"
                                ToolTip="Click to change background color"/>
                        <TextBlock x:Name="BgColorHexLabel"
                                   VerticalAlignment="Center" Margin="0,0,16,0"
                                   Foreground="#FF6C7086" FontSize="11"
                                   FontFamily="Consolas, Courier New"/>

                        <Rectangle Width="1" Height="16" Fill="#FF454570" Margin="0,0,16,0"/>

                        <!-- Opacity -->
                        <TextBlock Text="Opacity:" Foreground="#FFA6ADC8"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="OpacitySlider"
                                Width="120" Minimum="0" Maximum="100"
                                Value="{Binding BgOpacityPercent, Mode=TwoWay}"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"/>
                        <TextBlock Margin="8,0,0,0" Width="38"
                                   VerticalAlignment="Center"
                                   Foreground="#FF89B4FA" FontWeight="SemiBold"
                                   Text="{Binding BgOpacityPercent, StringFormat={}{0}%}"/>

                        <Rectangle Width="1" Height="16" Fill="#FF454570" Margin="16,0"/>

                        <!-- Font scale -->
                        <TextBlock Text="Font Scale:" Foreground="#FFA6ADC8"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="FontScaleSlider"
                                Width="110" Minimum="50" Maximum="200"
                                Value="{Binding FontScalePercent, Mode=TwoWay}"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"/>
                        <TextBlock Margin="8,0,0,0" Width="44"
                                   VerticalAlignment="Center"
                                   Foreground="#FF89B4FA" FontWeight="SemiBold"
                                   Text="{Binding FontScalePercent, StringFormat={}{0}%}"/>
                    </StackPanel>

                    <!-- Checkboxes row -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal">
                        <CheckBox Content="Embed in wallpaper layer (restart to take effect)"
                                  IsChecked="{Binding EmbedInWallpaper, Mode=TwoWay}"
                                  Foreground="#FFCDD6F4" VerticalAlignment="Center"/>
                        <CheckBox Content="Show title bar"
                                  IsChecked="{Binding ShowTitleBar, Mode=TwoWay}"
                                  Foreground="#FFCDD6F4"
                                  VerticalAlignment="Center" Margin="24,0,0,0"/>
                        <CheckBox x:Name="AutoStartCheck"
                                  Content="Auto-start on login"
                                  IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}"
                                  Foreground="#FFCDD6F4"
                                  VerticalAlignment="Center" Margin="24,0,0,0"/>
                    </StackPanel>

                    <!-- Position picker header -->
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Widget Position"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#FF89B4FA"
                                   VerticalAlignment="Center"/>
                        <Rectangle Grid.Column="2" Height="1" Fill="#FF454570" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4"
                                   Text="{Binding WidgetPositionText}"
                                   FontSize="11" Foreground="#FF6C7086"
                                   FontFamily="Consolas, Courier New"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Screen-map canvas -->
                    <Canvas Grid.Row="8"
                            x:Name="ScreenMapCanvas"
                            Height="110"
                            Background="#FF0D0D1A"
                            ClipToBounds="True"/>

                    <!-- Hint text -->
                    <TextBlock Grid.Row="10"
                               FontSize="10" Foreground="#FF6C7086"
                               Text="Drag the blue marker to reposition the widget — it moves live."/>
                </Grid>
            </Border>
        </Grid>

        <!-- ── OK / Cancel ── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="16,10,16,14">
            <Button Content="Cancel" Style="{StaticResource SubtleButton}"
                    Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save"   Style="{StaticResource AccentButton}"
                    Click="Save_Click"/>
        </StackPanel>

        <!-- ── Format token reference popup ── -->
        <Popup x:Name="FormatHelpPopup"
               Grid.Row="0"
               PlacementTarget="{Binding ElementName=FormatHelpBtn}"
               Placement="Left"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="#FF252535"
                    BorderBrush="#FF454570"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10">
                <StackPanel>
                    <TextBlock Text="Date / Time Format Tokens"
                               FontWeight="SemiBold" FontSize="12"
                               Foreground="#FF89B4FA" Margin="0,0,0,8"/>
                    <TextBox x:Name="FormatHelpText"
                             IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Consolas, Courier New" FontSize="11"
                             Foreground="#FFCDD6F4" Background="Transparent"
                             BorderThickness="0" Padding="0" IsTabStop="False"/>
                    <Rectangle Height="1" Fill="#FF454570" Margin="0,8,0,6"/>
                    <TextBlock FontSize="10" Foreground="#FF6C7086">
                        <Run Text="Countdown/Elapsed: "/>
                        <Run Text="HH:mm:ss" FontFamily="Consolas, Courier New" Foreground="#FFA6ADC8"/>
                        <Run Text="   Alarm: "/>
                        <Run Text="ddd HH:mm" FontFamily="Consolas, Courier New" Foreground="#FFA6ADC8"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
