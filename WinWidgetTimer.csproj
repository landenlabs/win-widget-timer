<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WinWidgetTimer</AssemblyName>
    <RootNamespace>WinWidgetTimer</RootNamespace>
    <Version>6.05.03</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Copyright>Copyright © 2026 LanDen Labs - Dennis Lang</Copyright>
    <Product>WinWidgetTimer</Product>
    <Description>Timer / Countdown / Alarm desktop widget</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\landenlabs.mp4">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\landenlabs.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
